<mujoco model="g1_43dof_inspire_hand_corridor scene">
  <include file="@G1_ROBOT_INCLUDE@"/>
  <!-- REMS Task A: 3.0 m x 2.2 m corridor with five examination waypoints. -->

  <statistic center="1.4 0 0.8" extent="3.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <texture type="2d" name="wall" builtin="flat" rgb1="0.55 0.55 0.58" width="512" height="512"/>
    <texture type="2d" name="marker" builtin="flat" rgb1="0.95 0.55 0.15" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall" texture="wall" texuniform="true" reflectance="0.05"/>
    <material name="marker" texture="marker" texuniform="true" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="1.5 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Corridor walls: length 3.0 m (x), width 2.2 m (y). Pelvis starts near x=0. -->
    <geom name="wall_left" pos="1.5 1.1 0.9" size="1.55 0.05 0.9" type="box" material="wall"/>
    <geom name="wall_right" pos="1.5 -1.1 0.9" size="1.55 0.05 0.9" type="box" material="wall"/>
    <geom name="wall_far" pos="3.05 0 0.9" size="0.05 1.15 0.9" type="box" material="wall"/>

    <!-- Task A waypoint markers (visual only). -->
    <site name="wp1_entry" pos="0.40 0.00 0.05" size="0.08" rgba="1 0.5 0 0.8" material="marker"/>
    <site name="wp2_left_branch" pos="0.90 0.45 0.05" size="0.08" rgba="1 0.5 0 0.8" material="marker"/>
    <site name="wp3_mid_corridor" pos="1.50 0.00 0.05" size="0.08" rgba="1 0.5 0 0.8" material="marker"/>
    <site name="wp4_right_branch" pos="2.10 -0.45 0.05" size="0.08" rgba="1 0.5 0 0.8" material="marker"/>
    <site name="wp5_far_end" pos="2.80 0.00 0.05" size="0.08" rgba="1 0.5 0 0.8" material="marker"/>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
