# Unitree SDK / sim roots (adjust to your machine)
UNITREE_SIM_ROOT=/path/to/unitree_sim_isaaclab
UNITREE_SDK2_ROOT=${UNITREE_SIM_ROOT}/unitree_sdk2_python
XR_TELEOP_ROOT=${UNITREE_SIM_ROOT}/xr_teleoperate
INSPIRE_HAND_SDK_ROOT=${UNITREE_SIM_ROOT}/inspire_hand_ws/inspire_hand_sdk
VISIONPRO_TELEOP_ROOT=${UNITREE_SIM_ROOT}/inspire_hand_ws/VisionProTeleop

# SONIC / GR00T whole-body control
GR00T_ROOT=/path/to/GR00T-WholeBodyControl

# TensorRT for SONIC deploy (required on first run to build .trt engines for your GPU)
# TensorRT_ROOT=/mnt/newssd/TensorRT/TensorRT-10.13.0.35

# Python for SONIC bridge — MUST have pyzmq (do not use bare system python3)
SONIC_PYTHON=/mnt/newssd/conda_envs/inspire_clean/bin/python

# Optional: real robot network interface
# SONIC_NET_IF=enp3s0

# Optional: Inspire dual-hand Modbus IPs (official G1 defaults)
# INSPIRE_HAND_LEFT_IP=192.168.123.210   # topic l
# INSPIRE_HAND_RIGHT_IP=192.168.123.211  # topic r
# INSPIRE_HAND_DDS_NETWORK=enp3s0
